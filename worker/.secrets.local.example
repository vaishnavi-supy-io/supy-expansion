# Secrets for the supy-expansion Worker — fill in as you find them.
#
#   cp .secrets.local.example .secrets.local
#   $EDITOR .secrets.local          # fill in whatever you have today
#   ./push-secrets.sh               # pushes only the filled-in ones
#
# Run it as many times as you like. Blank lines are skipped, so you can do this
# over several sittings and nothing already set gets clobbered.
#
# .secrets.local is gitignored and created 0600. It is still plaintext on disk,
# which is a step down from Cloudflare's write-only store — once every value is
# pushed and verified, delete it:  ./push-secrets.sh --shred

# ── REQUIRED — at least one, or the Worker refuses every submission ──────────

# HubSpot Private App token. Starts 'pat-'. This is the path production uses.
#   HubSpot -> Settings -> Integrations -> Private Apps -> your app -> Auth
HUBSPOT_ACCESS_TOKEN=

# Slack incoming webhook. The same channel supy-onboarding posts to.
#   api.slack.com/apps -> your app -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── STORAGE — without these, uploaded trade licences and VAT certs are lost ──
#   Cloudinary console -> Dashboard. Same account as supy-onboarding.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── OPERATIONS ───────────────────────────────────────────────────────────────

# Who gets named on a request, by country. JSON object:
#   {"AE":"someone@supy.io","SA":"someone@supy.io"}
COUNTRY_MANAGERS_JSON=

# Apps Script web app URL — see google-apps-script/Code.gs
GOOGLE_SCRIPT_URL=

# Optional: both needed to post warnings as threaded replies rather than
# standalone messages. Skip both and warnings still post.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Separate Apps Script endpoints for retailer lookup. Both fall back to
# GOOGLE_SCRIPT_URL when unset.
RETAILER_SHEET_URL=
USER_ACCESS_SHEET_URL=

# Rejects posts that do not carry it. See README.
FORM_SHARED_SECRET=

# Email receipts. Production has never had these set; skip and emails
# simply do not send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── ALREADY SET — leave blank unless you want to rotate them ─────────────────
# ADMIN_TOKEN   already set; the value is in worker/.admin-token
# RATE_LIMIT    already set to 500
