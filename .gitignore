node_modules/
.wrangler/

# Local Worker secrets. Never commit — set these with `wrangler secret put`.
.dev.vars
.env
.env.*

.DS_Store
*.log

# Credential files. None of these should exist: secrets live in Cloudflare's
# secret store and nowhere on a developer machine. Listed so that one created by
# accident, or by an older version of the setup scripts, cannot be committed.
worker/.sheeturl
worker/.admin-token
worker/.slacktoken

# Static assets copied in at deploy time by worker/sync-assets.sh.
# index.html and sample.html at the repo root stay the single source of truth.
worker/public/

# Locally filled-in secrets, pushed with worker/push-secrets.sh. Never committed.
worker/.secrets.local
